{
  "name": "exploroboros",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "branches": "node tools/branch-status.mjs",
    "dev:api": "wrangler pages dev",
    "db:migrate:local": "wrangler d1 migrations apply exploroboros --local",
    "db:migrate": "wrangler d1 migrations apply exploroboros --remote",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "konva": "^10.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-konva": "^19.2.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vite-imagetools": "^10.0.1",
    "vitest": "^4.1.9",
    "wrangler": "^4.107.0"
  }
}
